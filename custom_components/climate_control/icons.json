{
  "entity": {
    "binary_sensor": {
      "away": {
        "default": "mdi:home-account",
        "state": {
          "on": "mdi:home-export-outline"
        }
      }
    },
    "datetime": {
      "vacation_end": {
        "default": "mdi:calendar-end"
      }
    },
    "select": {
      "house_mode": {
        "default": "mdi:home-thermometer",
        "state": {
          "vacation": "mdi:beach",
          "off": "mdi:snowflake-thermometer"
        }
      }
    }
  },
  "services": {
    "start_vacation": {
      "service": "mdi:beach"
    }
  }
}
